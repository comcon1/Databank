{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ARTICLE_DOI": {
      "type": "string",
      "description": "DOI of the original publication of the experimental data. Becomes bioschema_properties.citation when no DATA_DOI is given"
    },
    "DATA_DOI": {
      "type": "string",
      "description": "DOI of the dataset deposition with raw NMR data. When present, this is the DOI that becomes bioschema_properties.citation - cite the data, not the article"
    },
    "DATA_REF": {
      "type": "string",
      "description": "Reference to deposited dataset, for data without a DOI"
    },
    "DATE": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "Date of the dataset publication (YYYY-MM-DD), retrievable from CrossRef or DataCite"
    },
    "TEMPERATURE": {
      "type": "number",
      "description": "Temperature (K) of the experiment"
    },
    "MEMBRANE_COMPOSITION": {
      "type": "object",
      "description": "Dictionary of molar fractions of membrane phase",
      "additionalProperties": {
        "type": "number"
      }
    },
    "SOLUTION_COMPOSITION": {
      "type": "object",
      "description": "Dictionary of ion concentrations in the system",
      "additionalProperties": {
        "type": "number"
      }
    },
    "ADDITIONAL_MOLECULES": {
      "type": "object",
      "description": "Dictionary of molecules which are not in the databank",
      "additionalProperties": true
    },
    "TOTAL_HYDRATION": {
      "type": "number",
      "description": "Total hydration of the system (water mass %)"
    },
    "PH": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 14 },
        { "type": "string", "enum": ["UNKNOWN"] },
        { "type": "string", "pattern": "^[0-9]+([.][0-9]+)?-[0-9]+([.][0-9]+)?" }
      ],
      "description": "pH of the system"
    },
    "PH_METHOD": {
      "type": "string",
      "description": "Method of pH setting or measurement (buffer / measurement)"
    },
    "REAGENT_SOURCES": {
      "type": "object",
      "description": "Description of lipid reagents. Source, purity, etc.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "SAMPLE_PROTOCOL": {
      "type": "string",
      "description": "Protocol for sample preparation (in free format, references are welcome)"
    },
    "NMR": {
      "type": "object",
      "description": "NMR-Specific Metadata",
      "additionalProperties": false,
      "properties": {
        "T_RF_HEATING": {
          "type": "string"
        },
        "INSTRUMENT": {
          "type": "string"
        },
        "METHOD": {
          "type": "string",
          "description": "Field identifying the NMR method used (formatted as METHOD:SUBMETHOD, e.g., '2H:QE').",
          "examples": [
            "2H:SP",
            "2H:QE",
            "CDLF:REDOR",
            "CDLF:DIPSHIFT",
            "CDLF:recDIPSHIFT",
            "PDLF:DROSS",
            "PDLF:R18_1^7",
            "PDLF:see_comments"
          ],
          "pattern": "^(2H:(SP|QE|see_comments)|CDLF:(REDOR|DIPSHIFT|recDIPSHIFT|see_comments)|PDLF:(DROSS|R[0-9]+(_[0-9]+)?\\^[0-9]+|see_comments))$"
        },
        "SIGN_MEASURED": {
          "type": "string"
        },
        "DETAILS": {
          "type": "string"
        }
      }
    },
    "XRAY": {
      "type": "object",
      "description": "X-ray Specific Metadata",
      "additionalProperties": false,
      "properties": {
        "SOURCE": {
          "type": "string"
        },
        "LAMBDA": {
          "type": "number"
        },
        "QRANGE": {
          "type": "string"
        },
        "DETECTOR": {
          "type": "string"
        },
        "DISTANCE": {
          "type": "number"
        },
        "DATATYPE": {
          "type": "string",
          "enum": [
            "batch",
            "SEC"
          ]
        },
        "EXPOSURE": {
          "type": "number"
        },
        "FRAMES": {
          "type": "number"
        },
        "SAMPLE_TYPE": {
          "type": "string",
          "enum": [
            "MLV",
            "SUV",
            "GUV",
            "OS",
            "BIC"
          ]
        }
      }
    },
    "bioschema_properties": {
      "$comment": "Bioschemas Dataset profile 1.0-RELEASE (https://bioschemas.org/profiles/Dataset/1.0-RELEASE). Written by the metadata enrichment tooling, not user-given. Only properties of that profile are accepted, plus dct:-prefixed DCMI terms and the local _source key. Not required, because the profile Minimum properties @context, @type, @id, dct:conformsTo, url and identifier are not emitted yet. Keep in sync with the identical block in readme_yaml_schema.json.",
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "patternProperties": {
        "^dct:": {}
      },
      "properties": {
        "@context": { "type": ["string", "object", "array"] },
        "@type": { "type": ["string", "array"] },
        "@id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "identifier": { "type": ["string", "array", "object"] },
        "url": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "$ref": "#/definitions/textOrDefinedTerm" }
        },
        "license": { "$ref": "#/definitions/creativeWorkRef" },
        "alternateName": {
          "type": ["string", "array"],
          "items": { "type": "string" }
        },
        "citation": {
          "type": "array",
          "items": { "$ref": "#/definitions/creativeWorkRef" }
        },
        "creator": {
          "type": "array",
          "items": { "$ref": "#/definitions/agent" }
        },
        "datePublished": { "$ref": "#/definitions/partialDate" },
        "distribution": {
          "type": "array",
          "items": { "$ref": "#/definitions/dataDownload" }
        },
        "includedInDataCatalog": {
          "type": ["string", "object", "array"]
        },
        "isBasedOn": {
          "type": "array",
          "items": { "$ref": "#/definitions/creativeWorkRef" }
        },
        "measurementTechnique": {
          "type": "array",
          "items": { "$ref": "#/definitions/textOrDefinedTerm" }
        },
        "publisher": { "$ref": "#/definitions/textOrAgent" },
        "variableMeasured": {
          "type": "array",
          "items": { "$ref": "#/definitions/textOrPropertyValue" }
        },
        "version": { "type": ["string", "number"] },
        "dateCreated": { "$ref": "#/definitions/partialDate" },
        "dateModified": { "$ref": "#/definitions/partialDate" },
        "hasPart": {
          "type": "array",
          "items": { "$ref": "#/definitions/creativeWorkRef" }
        },
        "isAccessibleForFree": { "type": "boolean" },
        "isPartOf": { "$ref": "#/definitions/creativeWorkRef" },
        "maintainer": {
          "type": "array",
          "items": { "$ref": "#/definitions/agent" }
        },
        "sameAs": {
          "type": ["string", "array"],
          "items": { "type": "string" }
        },
        "accessRights": {
          "$comment": "Not a schema.org term (this is DCMI dct:accessRights). Accepted for now; migrate to dct:accessRights, or to schema.org conditionsOfAccess / isAccessibleForFree.",
          "type": "string"
        },
        "articleLicense": {
          "$comment": "Not a schema.org term. The licence of the article the data belongs to should live on isPartOf.license - remap when the enrichment tooling is next touched.",
          "$ref": "#/definitions/creativeWorkRef"
        },
        "_source": { "$ref": "#/definitions/sourceProvenance" }
      }
    }
  },
  "required": [
    "TEMPERATURE",
    "MEMBRANE_COMPOSITION",
    "TOTAL_HYDRATION",
    "PH"
  ],
  "anyOf": [
    {
      "required": ["ARTICLE_DOI"]
    },
    {
      "required": ["DATA_DOI"]
    }
  ],
  "oneOf": [
    {
      "required": [
        "NMR"
      ]
    },
    {
      "required": [
        "XRAY"
      ]
    }
  ],
  "if": {
    "properties": {
      "PH": { "type": "string", "enum": ["UNKNOWN"] }
    }
  },
  "then": {
    "required": []
  },
  "else": {
    "required": [
      "PH_METHOD"
    ]
  },
  "definitions": {
    "definedTerm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "@type": { "const": "DefinedTerm" },
        "name": { "type": "string" },
        "termCode": { "type": "string" },
        "inDefinedTermSet": { "type": "string" },
        "url": { "type": "string" },
        "alternateName": { "type": "string" },
        "description": { "type": "string" },
        "identifier": { "type": "string" }
      }
    },
    "textOrDefinedTerm": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/definitions/definedTerm" }
      ]
    },
    "agent": {
      "$comment": "schema.org Person or Organization. Used for creator, publisher and maintainer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "@type": { "type": "string", "enum": ["Person", "Organization"] },
        "name": { "type": "string" },
        "identifier": { "type": "string" },
        "url": { "type": "string" },
        "affiliation": { "type": ["string", "object"] },
        "givenName": { "type": "string" },
        "familyName": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "textOrAgent": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/definitions/agent" }
      ]
    },
    "creativeWorkRef": {
      "$comment": "A schema.org CreativeWork node, or a bare string (DOI or URL). Used for license, citation, isBasedOn, isPartOf and hasPart.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "@type": { "type": "string" },
            "@id": { "type": "string" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "url": { "type": "string" },
            "sameAs": { "type": "string" },
            "identifier": { "type": "string" },
            "datePublished": { "$ref": "#/definitions/partialDate" },
            "publisher": { "$ref": "#/definitions/textOrAgent" },
            "isPartOf": { "$ref": "#/definitions/creativeWorkRef" },
            "license": { "$ref": "#/definitions/creativeWorkRef" },
            "spdx": {
              "$comment": "Local extension: SPDX licence identifier. Not a schema.org property of CreativeWork; identifier is the conformant home for it.",
              "type": ["string", "null"]
            }
          }
        }
      ]
    },
    "dataDownload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "@type": { "const": "DataDownload" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "contentUrl": { "type": "string" },
        "contentSize": { "type": ["integer", "string"] },
        "encodingFormat": { "type": "string" },
        "sameAs": { "type": "string" },
        "hasPart": {
          "type": "array",
          "items": { "type": ["string", "object"] }
        }
      }
    },
    "propertyValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "@type": { "const": "PropertyValue" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "value": { "type": ["string", "number", "boolean"] },
        "unitText": { "type": "string" },
        "unitCode": { "type": "string" },
        "propertyID": { "type": "string" }
      }
    },
    "textOrPropertyValue": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/definitions/propertyValue" }
      ]
    },
    "partialDate": {
      "$comment": "YYYY, YYYY-MM or YYYY-MM-DD. Must stay quoted in YAML: PyYAML parses an unquoted YYYY-MM-DD into datetime.date, which check-jsonschema then rejects as a non-string.",
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "sourceProvenance": {
      "$comment": "Local bookkeeping written by the metadata enrichment tooling: which API the record came from and when. Not a schema.org term - strip it before serialising JSON-LD.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": { "type": ["string", "null"] },
        "doi": { "type": ["string", "null"] },
        "spdxLicenseList": { "type": "string" },
        "retrieved": { "type": "string" }
      }
    }
  }
}
